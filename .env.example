# =============================================================
# ENVIRONMENT VARIABLES — TEMPLATE
# Kopiere diese Datei zu .env.local und fülle die Werte aus
# NIEMALS echte Werte in .env.example eintragen!
# =============================================================

# -------------------------------------------------------------
# Storyblok — Auslieferung (Astro)
# -------------------------------------------------------------
# Wird beim BAUEN der Website gelesen, serverseitig. Landet nicht im Browser.
# Preview-Token für den Visual Editor, Public-Token für den Produktions-Build.
STORYBLOK_TOKEN=

# -------------------------------------------------------------
# Storyblok — Management API (NUR Generator)
# -------------------------------------------------------------
# Schreibrechte auf den gesamten Space. Darf NIEMALS ins Frontend-Bundle
# gelangen und nicht in einer Variable mit PUBLIC_-Präfix stehen.
STORYBLOK_MANAGEMENT_TOKEN=
STORYBLOK_SPACE_ID=

# -------------------------------------------------------------
# Rebuild nach dem Veröffentlichen
# -------------------------------------------------------------
# Storyblok ruft bei `story.published` einen Deploy-Hook. Das Secret
# verifiziert, dass der Aufruf wirklich von Storyblok kommt.
STORYBLOK_WEBHOOK_SECRET=
DEPLOY_HOOK_URL=

# -------------------------------------------------------------
# MCP-Server (lokale Entwicklung, siehe .mcp.json.example)
# -------------------------------------------------------------
GITHUB_TOKEN=
