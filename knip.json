{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "_hinweis": "Findet ungenutzte Dateien, Exports und Dependencies. Monorepo mit npm-Workspaces.",
  "workspaces": {
    "packages/generator": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/viewer": {
      "entry": ["src/pages/**/*.{astro,ts}", "src/**/*Island.ts"],
      "project": ["src/**/*.{ts,astro}"]
    },
    "packages/flip-engine": {
      "_hinweis": "Einvendorter StPageFlip-Fork — Upstream-Code nicht auf ungenutzte Exports prüfen",
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/**"]
    }
  },
  "ignoreDependencies": ["lefthook", "@lhci/cli", "pa11y-ci"],
  "ignore": ["**/*.test.*", "**/test/**", "fixtures/**", "out/**"]
}
