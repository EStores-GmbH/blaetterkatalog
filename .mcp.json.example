{
  "_hinweis": "Kopiere zu .mcp.json (gitignored) und trage echte Tokens via Env ein.",
  "mcpServers": {
    "storyblok": {
      "type": "http",
      "url": "https://mcp.labs.storyblok.com",
      "_hinweis": "EU-Region für DSGVO. Content-Types, Stories und Assets abfragen."
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "_hinweis": "E2E-Tests, Tastatur-Durchläufe und Screenshots des Viewers"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "_hinweis": "Aktuelle Doku zu Astro, StPageFlip und Storyblok direkt im Kontext"
    }
  }
}
